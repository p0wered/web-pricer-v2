# Скопируйте в .env и заполните обязательные значения.

# Ключ шифрования секретов в базе (пароль DAV-сервера). Обязателен, не короче 16 символов.
# Сгенерировать: openssl rand -hex 32
# Если ключ сменить или потерять, пароль DAV нужно будет заново ввести в настройках.
APP_SECRET=

# Пароль входа при первом запуске (не короче 8 символов). Нужен только пока пароль ещё не
# задан; дальше пароль меняется в настройках или командой `webpricer password`.
APP_INITIAL_PASSWORD=

# Время жизни сессии без активности, минуты.
SESSION_TTL_MINUTES=120

# true — приложение работает за обратным прокси (HTTPS) и берёт IP клиента из X-Forwarded-For.
# false — если приложение открыто напрямую, без прокси.
TRUST_PROXY=true

# Флаг Secure у cookie сессии: auto — если запрос пришёл по HTTPS (за прокси — по
# X-Forwarded-Proto), true — всегда, false — никогда.
COOKIE_SECURE=auto

# Часовой пояс расписания импорта.
SCHEDULE_TIMEZONE=Europe/Moscow

# Уровень логов: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
